# Copy this file to backend/.env. Keep Razorpay in Test Mode for development.
MONGO_URI=mongodb://127.0.0.1:27017/shopkart
JWT_SECRET=replace-with-a-long-random-secret

# Keep test mode until production credentials are explicitly configured.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_replace_with_dashboard_key_id
RAZORPAY_KEY_SECRET=replace_with_dashboard_test_key_secret